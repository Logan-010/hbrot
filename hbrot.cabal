cabal-version:      3.0
name:               hbrot
version:            0.1.0.0
-- synopsis:
-- description:
license:            MIT
license-file:       LICENSE
author:             Logan-010
maintainer:         Logan-010
build-type:         Simple

common warnings
    ghc-options: -Wall

executable hbrot
    import:           warnings
    main-is:          Main.hs
    other-modules:    Brot
                      Colormaps
                      Cli
    -- other-extensions:
    build-depends:    base ==4.20.2.0,
                      deepseq ==1.5.0.0,
                      JuicyPixels ==3.3.9,
                      parallel ==3.3.0.0,
                      vector ==0.13.2.0,
                      random ==1.3.1
    ghc-options:      -O2 -threaded -rtsopts -with-rtsopts=-N
    hs-source-dirs:   app
    default-language: Haskell2010
